# ==== PSD Website - Mẫu biến môi trường ====
# Copy file này thành ".env" và điền giá trị thật. KHÔNG commit file .env.

# --- Database (PostgreSQL / Neon) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Bảo mật phiên đăng nhập admin (JWT) ---
# Chuỗi ngẫu nhiên dài, đổi khi lên production
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# --- URL site ---
NEXTAUTH_URL="https://psdgroup.vn"
NEXT_PUBLIC_SITE_URL="https://psdgroup.vn"
NEXT_PUBLIC_BASE_URL="https://psdgroup.vn"
NEXT_PUBLIC_SITE_NAME="PSD Group"

# --- Tài khoản admin mặc định (SUPER_ADMIN, dự phòng) ---
ADMIN_EMAIL="admin@psdgroup.vn"
ADMIN_PASSWORD="đặt-mật-khẩu-mạnh"
# Tài khoản admin bổ sung (tuỳ chọn), có thể thêm _3, _4 ... tới _10
ADMIN_EMAIL_2=""
ADMIN_PASSWORD_2=""

# --- Lưu trữ ảnh upload: Vercel Blob (hiện tại) ---
BLOB_READ_WRITE_TOKEN=""

# --- (Khi chuyển về server riêng, xem DEPLOY.md mục 5.3) ---
# MEDIA_DIR="/var/www/psd-media"
# MEDIA_PUBLIC_URL="https://psdgroup.vn/media"

# --- (Tuỳ chọn) Cloudflare R2 — chỉ dùng nếu chọn R2, xem src/lib/r2.ts ---
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="psd-website"
# R2_PUBLIC_BASE_URL="https://images.psdgroup.vn"
